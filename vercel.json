{
  "headers": [
    {
      "source": "/assets/uploads/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|backend/api/boot-settings\\.js).*)",
      "destination": "/index.html"
    }
  ]
}
